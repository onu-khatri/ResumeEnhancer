{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Caching": {
    "Provider": "InMemory",
    "KeyPrefix": "ResumeEnhancer",
    "DefaultExpiration": "00:30:00",
    "Redis": {
      "Configuration": "localhost:6379",
      "InstanceName": "ResumeEnhancer:"
    },
    "MemCache": {
      "Servers": [
        {
          "Host": "localhost",
          "Port": 11211
        }
      ],
      "ConnectTimeout": "00:00:02",
      "ReceiveTimeout": "00:00:02"
    }
  },
  "Resilience": {
    "Profiles": {
      "LimiterProvider": {
        "RetryCount": 2,
        "BaseDelay": "00:00:00.050",
        "MaxDelay": "00:00:00.500",
        "JitterMin": "00:00:00.025",
        "JitterMax": "00:00:00.100",
        "Timeout": "00:00:00.750",
        "CircuitBreakerFailureThreshold": 5,
        "CircuitBreakerSamplingWindow": "00:01:00",
        "CircuitBreakerBreakDuration": "00:00:05",
        "ConcurrencyLimit": 128
      },
      "DbCache": {
        "RetryCount": 2,
        "BaseDelay": "00:00:00.100",
        "MaxDelay": "00:00:01",
        "JitterMin": "00:00:00.050",
        "JitterMax": "00:00:00.250",
        "Timeout": "00:00:02",
        "CircuitBreakerFailureThreshold": 5,
        "CircuitBreakerSamplingWindow": "00:01:00",
        "CircuitBreakerBreakDuration": "00:00:10",
        "ConcurrencyLimit": 64
      },
      "AuditOutbox": {
        "RetryCount": 4,
        "BaseDelay": "00:00:01",
        "MaxDelay": "00:05:00",
        "JitterMin": "00:00:00.250",
        "JitterMax": "00:00:02",
        "Timeout": "00:00:05",
        "CircuitBreakerFailureThreshold": 5,
        "CircuitBreakerSamplingWindow": "00:05:00",
        "CircuitBreakerBreakDuration": "00:00:30",
        "ConcurrencyLimit": 16
      },
      "SafeOutboundHttp": {
        "RetryCount": 2,
        "BaseDelay": "00:00:00.200",
        "MaxDelay": "00:00:02",
        "JitterMin": "00:00:00.100",
        "JitterMax": "00:00:00.500",
        "Timeout": "00:00:05",
        "CircuitBreakerFailureThreshold": 5,
        "CircuitBreakerSamplingWindow": "00:01:00",
        "CircuitBreakerBreakDuration": "00:00:15",
        "ConcurrencyLimit": 32
      }
    }
  },
  "Auth": {
    "Security": {
      "LockoutThreshold": 5,
      "LockoutWindow": "00:15:00",
      "ProgressiveLoginDelays": [ "00:00:00", "00:00:01", "00:00:02", "00:00:05", "00:00:15" ],
      "Issuer": "ResumeEnhancer",
      "Audience": "ResumeEnhancer.Api",
      "AccessTokenLifetime": "00:30:00",
      "ClockSkew": "00:00:30",
      "KeyRotationPeriod": "180.00:00:00",
      "PreviousKeyOverlap": "02.00:00:00",
      "ActiveKeyId": "primary",
      "DataProtectionKeyRingPath": "",
      "DataProtectionApplicationName": "ResumeEnhancer",
      "DataProtectionPurpose": "AuthModule.SigningKeyMaterial.v1",
      "RefreshCookieName": "__Host-resumeenhancer-refresh",
      "RefreshCookiePath": "/",
      "RefreshCookieHttpOnly": true,
      "RefreshCookieSecure": true,
      "RefreshCookieSameSite": "Lax",
      "CsrfCookieName": "resumeenhancer-csrf",
      "CsrfHeaderName": "X-CSRF-Token",
      "TrustedOrigins": [ "https://localhost" ]
    }
  },
  "AllowedHosts": "*"
}
