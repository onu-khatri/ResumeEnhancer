{
  "Resilience": {
    "Profiles": {
      "LimiterProvider": { "Timeout": "00:00:01", "ConcurrencyLimit": 256 },
      "DbCache": { "Timeout": "00:00:03" },
      "AuditOutbox": { "ConcurrencyLimit": 16 },
      "SafeOutboundHttp": { "Timeout": "00:00:05" }
    }
  },
  "Caching": {
    "Provider": "Redis",
    "Redis": {
      "Configuration": "localhost:6379",
      "InstanceName": "ResumeEnhancer:"
    }
  },
  "Auth": {
    "Security": {
      "TrustedOrigins": [
        "https://resumeenhancer.com",
        "https://www.resumeenhancer.com",
        "https://app.resumeenhancer.com"
      ]
    }
  }
}
